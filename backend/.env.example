# Copy to .env (never commit .env)
NODE_ENV=development
PORT=8080

# Comma-separated list of allowed browser origins (website). No "*" in production.
CORS_ORIGINS=http://localhost:5173

# Use "firestore" for real data, "memory" for local testing without Firebase.
DATA_STORE=memory

# --- Firebase Admin (needed only when DATA_STORE=firestore) ---
# Option A (local dev): path to the service-account JSON you downloaded. Keep it OUTSIDE git.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/serviceAccountKey.json
# Option B (production hosts): the whole JSON on one line, as a secret env var.
# FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=your-project-id
