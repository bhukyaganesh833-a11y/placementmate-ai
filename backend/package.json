{
  "name": "placementmate-backend",
  "version": "0.1.0",
  "private": true,
  "description": "PlacementMate AI shared REST backend (Express + Firestore)",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node src/server.js",
    "test": "node --test --test-reporter=spec \"tests/**/*.test.js\"",
    "seed": "node --env-file=.env scripts/seed.js",
    "set-admin": "node --env-file=.env scripts/setAdmin.js",
    "smoke:admin": "node --env-file=.env scripts/adminSmoke.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.0.0",
    "helmet": "^8.0.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
